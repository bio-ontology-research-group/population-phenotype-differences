     "text": "[{\"text\": \"no motor response was elicited from the extensor digitorum brevis\", \"excluded\": false}, {\"text\": \"Fibrillations and polyphasic action potentials were present on EMG\", \"excluded\": false}, {\"text\": \"creatine kinase (CK) level was 1,452 IU/L\", \"excluded\": false}, {\"text\": \"muscle fiber diameters were large ranging from 50 to 80 \u03bcm\", \"excluded\": false}, {\"text\": \"Many of the fibers contained single or multiple unrimmed vacuoles\", \"excluded\": false}, {\"text\": \"electron microscopy showed electron-dense material within vacuoles\", \"excluded\": false}, {\"text\": \"slowly progressive severe upper and lower limb weaknesses\", \"excluded\": false}, {\"text\": \"distal more than proximal upper limb weakness affecting wrist extension\", \"excluded\": false}, {\"text\": \"severe proximal weakness (grade 2/3) with no movement at the ankles\", \"excluded\": false}, {\"text\": \"reduced vibration sense at the ankles\", \"excluded\": false}, {\"text\": \"normal upper limb muscle strength\", \"excluded\": true}, {\"text\": \"Motor and sensory nerve conduction studies were normal\", \"excluded\": true}, {\"text\": \"no increase in endomysial connective tissue or evidence of inflammation, necrosis, or regeneration\", \"excluded\": true}, {\"text\": \"no evidence of glycogen, increased lipid, or acid phosphate staining in the vacuoles\", \"excluded\": true}, {\"text\": \"without any features suggesting neurogenic change\", \"excluded\": true}, {\"text\": \"Sensory modalities were preserved\", \"excluded\": true}, {\"text\": \"No low amplitude or brief polyphasic motor units were seen\", \"excluded\": true}]"
