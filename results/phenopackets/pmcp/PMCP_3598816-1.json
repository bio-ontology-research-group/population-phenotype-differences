    "name": "unmappedPhenotypeText",
    "value": {
     "text": "[{\"text\": \"laminated intraglomerular lipoprotein thrombi\", \"excluded\": false}, {\"text\": \"Oil Red O staining was positive\", \"excluded\": false}, {\"text\": \"glomerular capillary lumina were occupied by granules of various sizes\", \"excluded\": false}, {\"text\": \"three were globally sclerotic, and one was segmental sclerotic\", \"excluded\": false}, {\"text\": \"severe dilated capillaries filled with a foamy, whorled, mesh-like material\", \"excluded\": false}, {\"text\": \"extensive ischemic changes, retraction of the glomerular tuft and marked thickening and wrinkling of the capillary wall\", \"excluded\": false}, {\"text\": \"Double-contour formations were obvious\", \"excluded\": false}, {\"text\": \"Swelling of endothelial cells and fluffy masses (fibrin) in arterioles caused narrowing and closure of vascular lumens\", \"excluded\": false}, {\"text\": \"Thrombosis was found in the arterioles\", \"excluded\": false}, {\"text\": \"large, intraluminal, finely vacuolated extracellular masses\", \"excluded\": false}, {\"text\": \"A brain CT scan did not reveal any abnormality\", \"excluded\": true}, {\"text\": \"The patient did not have any evidence of malignancy, pregnancy or abortion\", \"excluded\": true}, {\"text\": \"she had not experienced diarrhea or infections\", \"excluded\": true}, {\"text\": \"she did not present any evidence of renal dysfunction, proteinuria or thrombocytopenia\", \"excluded\": true}]"
