 "phenotypicFeatures": [
  {
   "type": {
    "id": "HP:0031956",
    "label": "Elevated circulating aspartate aminotransferase concentration"
   },
   "description": "moderate aminotransferase elevation (aspartate aminotransferase 178 U/L [N: <50]; alanine aminotransferase 11 U/L [N: <50])"
  },
  {
   "type": {
    "id": "HP:0003155",
    "label": "Elevated circulating alkaline phosphatase concentration"
   },
   "description": "moderately elevated cholestasis markers (alkaline phosphatase 489 U/L [N: <102]; gamma-glutamyl transferase [GGT] 338 U/L [N: <40]; total bilirubin 35 \u03bcmol/L [N: <25] with conjugated bilirubin 15 \u03bcmol/L [N: <9.5])"
  },
  {
   "type": {
    "id": "HP:0001409",
    "label": "Portal hypertension"
   },
   "description": "Prothrombin time was 50%, international normalized ratio 1.39, factor V 64%, and low platelets (47 g/L [N: <350]), suggesting the presence of portal hypertension"
  },
  {
   "type": {
    "id": "HP:0001394",
    "label": "Cirrhosis"
   },
   "description": "Percutaneous liver biopsy showed chronic active hepatitis with cirrhosis"
  },
  {
   "type": {
    "id": "HP:0001414",
    "label": "Microvesicular hepatic steatosis"
   },
   "description": "Mallory-Denk bodies and mild microvesicular steatosis were also seen"
  },
  {
   "type": {
    "id": "HP:0025321",
    "label": "Copper accumulation in liver"
   },
   "description": "significantly elevated fresh liver-fragment copper concentration (29 mmol/kg [N = 0.16\u20130.55]) and dry tissue concentration (1,845 \u03bcg/g [N = 10\u201335])"
  },
  {
   "type": {
    "id": "HP:0000488",
    "label": "Retinopathy"
   },
   "description": "showed a nonspecific retinopathy"
  },
  {
   "type": {
    "id": "HP:0001298",
    "label": "Encephalopathy"
   },
   "description": "refractory encephalopathy"
  },
  {
   "type": {
    "id": "HP:0030948",
    "label": "Elevated gamma-glutamyltransferase level"
   },
   "description": "Persistent GGT elevation at 4 months after liver transplantation"
  },
  {
   "type": {
    "id": "HP:0011040",
    "label": "Abnormal intrahepatic bile duct morphology"
   },
   "description": "mild interlobular bile duct dystrophy"
  },
  {
