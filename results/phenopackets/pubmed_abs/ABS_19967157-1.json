 "phenotypicFeatures": [
  {
   "type": {
    "id": "HP:0030402",
    "label": "Abnormal platelet aggregation"
   },
   "description": "Abnormal platelet function was observed using platelet aggregometry with the agonists epinephrine and adenosine diphosphate (ADP)"
  },
  {
   "type": {
    "id": "HP:0040235",
    "label": "Leukocyte inclusion bodies"
   },
   "description": "Patient granulocytes and megakaryocytes, but not platelets, contained abnormal MHC-IIA inclusions visualised by confocal immunofluorescence or electron microscopy"
  },
  {
   "type": {
    "id": "HP:0031385",
    "label": "Megakaryocyte nucleus hypolobulation"
   },
   "description": "Megakaryocytes grown in culture were smaller and contained hypolobulated nuclei compared to controls"
  },
  {
   "type": {
    "id": "HP:0012143",
    "label": "Abnormal megakaryocyte morphology"
   },
   "description": "Bone marrow-derived megakaryocytes revealed a preponderance of immature forms, the presence of structurally diverse inclusion bodies, and frequent emperipolesis as assessed by electron microscopy"
  }
