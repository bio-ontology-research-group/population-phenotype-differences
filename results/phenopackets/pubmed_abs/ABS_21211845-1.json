 "phenotypicFeatures": [
  {
   "type": {
    "id": "HP:0030642",
    "label": "Fundus albipunctatus"
   },
   "description": "Uniform, yellow-white dots typical of fundus albipunctatus"
  },
  {
   "type": {
    "id": "HP:0000479",
    "label": "Abnormal retinal morphology"
   },
   "description": "discrete, hyperreflective formations extending from the Bruch's membrane and retinal pigment epithelium (RPE) into the level of the external limiting membrane"
  },
  {
   "type": {
    "id": "HP:0030329",
    "label": "Retinal thinning on OCT"
   },
   "description": "reduced thickness of the central retina and the RPE-outer segment complex"
  },
  {
   "type": {
    "id": "HP:0025159",
    "label": "Hypoautofluorescent retinal lesion"
   },
   "description": "The intensity of the FAF was severely reduced in the entire fundus"
  },
  {
   "type": {
    "id": "HP:0000654",
    "label": "Decreased light- and dark-adapted electroretinogram amplitude"
   },
   "description": "barely recordable rod response after standard dark adaptation"
  },
  {
   "type": {
    "id": "HP:0030469",
    "label": "Abnormal dark-adapted electroretinogram"
   },
   "description": "normalization (increase by more than 700%) of the response after prolonged dark adaptation"
  },
  {
   "type": {
    "id": "HP:0030479",
    "label": "Abnormal amplitude of light-adapted flicker electroretinogram"
   },
   "description": "The cone 30-Hz flicker response was reduced after standard dark adaptation"
  },
  {
   "type": {
    "id": "HP:0030475",
    "label": "Abnormal timing of dark-adapted dim flash electroretinogram"
   },
   "description": "increased by >50% after prolonged dark adaptation"
  },
  {
   "type": {
    "id": "HP:0030468",
    "label": "Abnormal multifocal electroretinogram"
   },
   "description": "mfERG demonstrated reduced central and peripheral responses"
